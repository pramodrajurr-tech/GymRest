<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/plate_blue"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="12dp"
    android:paddingEnd="24dp"
    android:paddingBottom="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/setsText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif-condensed"
            android:text="No sets yet"
            android:textColor="@color/chalk"
            android:textSize="20sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/resetBtn"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="Reset sets"
            android:textAllCaps="false"
            android:textColor="@color/chalk_muted"
            android:textSize="15sp" />
    </LinearLayout>

    <com.gymrest.timer.RingView
        android:id="@+id/ring"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:layout_weight="1" />

    <LinearLayout
        android:id="@+id/stepper"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/minusBtn"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/btn_outline"
            android:stateListAnimator="@null"
            android:text="−15 sec"
            android:textAllCaps="false"
            android:textColor="@color/chalk"
            android:textSize="16sp" />

        <Button
            android:id="@+id/plusBtn"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/btn_outline"
            android:stateListAnimator="@null"
            android:text="+15 sec"
            android:textAllCaps="false"
            android:textColor="@color/chalk"
            android:textSize="16sp" />
    </LinearLayout>

    <Button
        android:id="@+id/primaryBtn"
        android:layout_width="match_parent"
        android:layout_height="68dp"
        android:layout_marginTop="14dp"
        android:background="@drawable/btn_primary"
        android:stateListAnimator="@null"
        android:text="Start rest"
        android:textAllCaps="false"
        android:textColor="@color/ink"
        android:textSize="21sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/testBtn"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="Test alarm"
            android:textAllCaps="false"
            android:textColor="@color/chalk_muted"
            android:textSize="15sp" />

        <Button
            android:id="@+id/setupBtn"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="Phone settings"
            android:textAllCaps="false"
            android:textColor="@color/chalk_muted"
            android:textSize="15sp" />
    </LinearLayout>
</LinearLayout>
